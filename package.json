{
  "name": "showcase-website-factory",
  "version": "1.0.0",
  "private": true,
  "description": "A reusable production system for high-end portfolio and showcase websites.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm images:build && next dev",
    "images:build": "node scripts/build-images.mjs",
    "build": "pnpm images:build && next build",
    "preview:pages": "wrangler pages dev out --ip 127.0.0.1 --port 3101",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "pnpm images:build && playwright test",
    "test:static": "playwright test --config playwright.static.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "qa": "pnpm format:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test:e2e && pnpm build && pnpm test:static"
  },
  "dependencies": {
    "motion": "13.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.136.3"
  }
}
